#!/bin/sh
# Started by init on tty1 (see /etc/inittab).  Runs KEGS full screen on
# the HDMI display, with its files on the KEGS partition (/kegs).

AUDIO=auto
KEGS_ARGS=

# Optional settings from /kegs/kegs.env (KEY=value lines, may have CRLF)
if [ -f /kegs/kegs.env ]; then
	while IFS='=' read -r key val; do
		val=$(printf '%s' "$val" | tr -d '\r')
		case "$key" in
		AUDIO)		AUDIO=$val ;;
		KEGS_ARGS)	KEGS_ARGS=$val ;;
		SDL_*)		export "$key=$val" ;;
		esac
	done < /kegs/kegs.env
fi

# Sound cards that exist: the names in [brackets] in /proc/asound/cards
has_card() {
	grep -q "^ *[0-9][0-9]* *\[$1 *\]" /proc/asound/cards 2>/dev/null
}

# AUDIO=auto: the HDMI socket the screen is on, else the 3.5mm jack.
#  1. The screen's ELD file lists its sound formats (sad_count 1 or more).
#  2. No ELD file (not every kernel has it): the HDMI socket the display
#     driver says is connected.  HDMI-A-1 is vc4hdmi0, HDMI-A-2 vc4hdmi1
#     (the sockets printed HDMI 0 and HDMI 1 on the board).
AUDIO_WHY="set in kegs.env"
if [ "$AUDIO" = auto ]; then
	AUDIO=
	for n in 0 1; do
		for eld in /proc/asound/vc4hdmi$n/eld*; do
			[ -f "$eld" ] || continue
			if grep -q 'sad_count[[:space:]]*[1-9]' "$eld" &&
			   has_card "vc4hdmi$n"; then
				AUDIO=vc4hdmi$n
				AUDIO_WHY="screen on HDMI $n lists sound formats"
			fi
		done
		[ -n "$AUDIO" ] && break
	done
	if [ -z "$AUDIO" ]; then
		for n in 0 1; do
			for st in /sys/class/drm/card*-HDMI-A-$((n + 1))/status; do
				[ -f "$st" ] || continue
				if [ "$(cat "$st")" = connected ] &&
				   has_card "vc4hdmi$n"; then
					AUDIO=vc4hdmi$n
					AUDIO_WHY="screen connected to HDMI $n"
				fi
			done
			[ -n "$AUDIO" ] && break
		done
	fi
	if [ -z "$AUDIO" ]; then
		AUDIO=Headphones
		AUDIO_WHY="no HDMI screen found"
	fi
fi
# The chosen card must exist, or there is no sound at all: else take the
#  first sound card there is
if ! has_card "$AUDIO"; then
	FIRST=$(sed -n 's/^ *[0-9][0-9]* *\[\([^] ]*\) *\].*/\1/p' \
					/proc/asound/cards 2>/dev/null | head -n 1)
	AUDIO_WHY="$AUDIO_WHY; no $AUDIO sound card, using ${FIRST:-none}"
	AUDIO=${FIRST:-$AUDIO}
fi

# ALSA: send sound to the chosen card (vc4hdmi0 = HDMI, Headphones = jack)
export HOME=/tmp/kegs-home
mkdir -p "$HOME"
case "$AUDIO" in
vc4hdmi*)	PCM="hdmi:CARD=$AUDIO,DEV=0" ;;	# HDMI needs the hdmi plugin
*)		PCM="plughw:CARD=$AUDIO,DEV=0" ;;
esac
printf 'pcm.!default "%s"\nctl.!default { type hw card "%s" }\n' \
	"$PCM" "$AUDIO" > "$HOME/.asoundrc"
# ...and name it in AUDIODEV too, like pi-kegs.sh on Pi OS Lite (where
#  HDMI sound works): SDL opens it directly, without needing ~/.asoundrc
export AUDIODEV="$PCM"

export SDL_VIDEODRIVER=kmsdrm
export SDL_AUDIODRIVER=alsa

# Nothing is shown on the screen except a missing ROM; problems go to
#  the logs (kegs.log / boot-log.txt on the KEGS partition)
if ! mountpoint -q /kegs; then
	echo "KEGS partition (/kegs) is not mounted" > /tmp/kegs-start.log
	sleep 10
	exit 1
fi
cd /kegs || exit 1

# No ROM file yet: say so on the screen instead of a black screen
HAVE_ROM=0
for f in /kegs/ROM* /kegs/rom* /kegs/Rom* /kegs/*.rom /kegs/*.ROM; do
	[ -f "$f" ] && HAVE_ROM=1
done
if [ "$HAVE_ROM" = 0 ]; then
	echo
	echo "  No IIgs ROM file on the GS40 partition."
	echo "  Put the SD card in a Mac or PC and copy your ROM file to the"
	echo "  GS40 drive, named ROM (or ROM.01 / ROM.03).  Then restart."
	sleep 60
	exit 1
fi

# Logs on the KEGS partition, so they can be read on a Mac or PC
# (written in the background, so KEGS starts without waiting)
LOG=/kegs/kegs.log
(
	sleep 5
	{
		echo "=== $(date)  KEGS_ARGS=$KEGS_ARGS AUDIO=$AUDIO"
		ls -l /dev/dri /kegs 2>&1
		cat /tmp/kegs-input.txt
		echo "AUDIO used: $AUDIO ($AUDIO_WHY)"
		cat /proc/asound/cards
		ls /proc/asound /proc/asound/card* 2>&1
		head -n 12 /proc/asound/card*/eld* 2>&1
		for st in /sys/class/drm/card*-HDMI*/status; do
			echo "$st: $(cat "$st")"
		done
		# Sound: what KEGS has open (state RUNNING = playing), the
		#  card's controls (ELD = the screen's sound formats) and
		#  whether alsa-lib knows the "hdmi" device of vc4 cards
		echo "--- sound: AUDIODEV=$AUDIODEV"
		for f in /proc/asound/card*/pcm0p/sub0/status; do
			echo "$f:"; cat "$f"
		done
		amixer -c "$AUDIO" contents 2>&1 | head -n 40
		ls /usr/share/alsa/cards 2>&1 | grep -i vc4
		aplay -L 2>&1 | grep -A1 '^hdmi'
		ls -la /kegs/.kegs-splash
		cat /tmp/kegs-splash.log
		cat /proc/fb
		ps
		dmesg
	} > /kegs/boot-log.txt 2>&1
	sync
	# Network log for the first 3 minutes (Wi-Fi debugging)
	n=0
	while [ $n -lt 9 ]; do
		sleep 20
		{
			echo "=== $(date +%T)"
			ls /sys/class/net
			ip addr
			for f in /tmp/kegs-net/status /tmp/kegs-net/scan \
					/tmp/kegs-net/kegs-net.err; do
				echo "--- $f"
				cat "$f" 2>&1
			done
			ps | grep -E 'wpa|udhcpc|kegs-net' | grep -v grep
			dmesg | grep -iE 'brcm|wlan|cfg80211|mmc1'
		} > /kegs/net-log.txt 2>&1
		sync
		n=$((n + 1))
	done
) &

# KEGS saves its start-up screen here; S00kegs-splash shows it at boot
export KEGS_SPLASH=/kegs/.kegs-splash

# Start-up is fast now: give the USB keyboard up to 3 seconds to appear
i=0
while [ $i -lt 3 ] && ! ls /dev/input/by-path/*kbd* >/dev/null 2>&1; do
	sleep 1
	i=$((i + 1))
done
ls -l /dev/input /dev/input/by-path > /tmp/kegs-input.txt 2>&1

START=$(date +%s)
# shellcheck disable=SC2086
/usr/bin/gs40 $KEGS_ARGS > "$LOG" 2>&1
RC=$?
echo "=== KEGS exited with code $RC" >> "$LOG"
sync

# Stopped right away: wait a little before init starts it again
if [ $(( $(date +%s) - START )) -lt 15 ]; then
	sleep 10
fi
